# Copy to .env.local and adjust, or set the same keys in your deployment platform.
#
# Nothing here is required. Without any of it the app runs on its built-in
# simulated market feed and the deterministic (no-API-key) AI brief.

# --- App ---
PORT=3000

# --- AI brief (optional) ---
# With no key the brief is still generated, deterministically, from the signals.
# Set a key to let a model reword the prose. Numbers always come from the signals.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_TOKENS=900
#
# OPENAI_BASE_URL accepts any OpenAI-compatible endpoint, so a free OpenRouter
# model works without a paid OpenAI key:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=liquid/lfm-2.5-2.6b:free
# OPENAI_MAX_TOKENS is the completion budget (default 900). Reasoning models
# spend part of it thinking before they write anything.
